<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>QaaS.Framework.SDK</id>
    <version>1.6.4</version>
    <authors>SmokeTeam</authors>
    <readme>README.md</readme>
    <description>Core SDK APIs for building on the QaaS framework.</description>
    <repository type="git" url="https://github.com/TheSmokeTeam/QaaS.Framework" commit="daa83a2b7ddcba5142760fc42833486219efd1ba" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="QaaS.Framework.Configurations" version="1.6.4" exclude="Build,Analyzers" />
        <dependency id="QaaS.Framework.Infrastructure" version="1.6.4" exclude="Build,Analyzers" />
        <dependency id="QaaS.Framework.Serialization" version="1.6.4" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration.Json" version="10.0.5" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Logging" version="10.0.5" exclude="Build,Analyzers" />
        <dependency id="Serilog.Extensions.Logging" version="10.0.0" exclude="Build,Analyzers" />
        <dependency id="Serilog.Sinks.Console" version="6.1.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>