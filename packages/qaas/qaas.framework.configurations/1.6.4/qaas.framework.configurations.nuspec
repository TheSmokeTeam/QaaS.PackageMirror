<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>QaaS.Framework.Configurations</id>
    <version>1.6.4</version>
    <authors>SmokeTeam</authors>
    <readme>README.md</readme>
    <description>Configuration models and options for the QaaS framework.</description>
    <repository type="git" url="https://github.com/TheSmokeTeam/QaaS.Framework" commit="daa83a2b7ddcba5142760fc42833486219efd1ba" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Microsoft.Extensions.Configuration" version="10.0.5" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration.Abstractions" version="10.0.5" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration.CommandLine" version="10.0.5" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration.EnvironmentVariables" version="10.0.5" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Logging" version="10.0.5" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Options" version="10.0.5" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Options.DataAnnotations" version="10.0.5" exclude="Build,Analyzers" />
        <dependency id="NetEscapades.Configuration.Yaml" version="3.1.0" exclude="Build,Analyzers" />
        <dependency id="Serilog" version="4.3.1" exclude="Build,Analyzers" />
        <dependency id="Serilog.Settings.Configuration" version="10.0.0" exclude="Build,Analyzers" />
        <dependency id="YamlDotNet" version="16.3.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>