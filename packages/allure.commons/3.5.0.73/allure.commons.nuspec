<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Allure.Commons</id>
    <version>3.5.0.73</version>
    <authors>Alexander Bakanov</authors>
    <icon>allure-net.png</icon>
    <projectUrl>https://github.com/allure-framework/allure-csharp/wiki/Allure.Commons</projectUrl>
    <description>.net implementation of Allure java-commons</description>
    <tags>allure</tags>
    <repository type="git" url="https://github.com/allure-framework/allure-csharp" commit="06141c188da00e30574da04735f16f47ff683dc1" />
    <dependencies>
      <group targetFramework=".NETFramework4.5">
        <dependency id="MimeTypesMap" version="1.0.8" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="MimeTypesMap" version="1.0.8" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <contentFiles>
      <files include="any/net45/allureConfig.Template.json" buildAction="Content" />
      <files include="any/netstandard2.0/allureConfig.Template.json" buildAction="Content" />
    </contentFiles>
  </metadata>
</package>